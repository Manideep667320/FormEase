# ==============================================================================
# FormEase Environment Configuration Template (.env.example)
# ==============================================================================

PORT=5000
JWT_SECRET=your_jwt_secret

# 1. Neon Database
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Object Storage (formease-storage)
OBJECT_STORAGE_BUCKET=formease-storage
S3_BUCKET_NAME=formease-storage
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_ACCESS_KEY_ID=your_access_key_here
S3_SECRET_ACCESS_KEY=your_secret_key_here
OBJECT_STORAGE_PUBLIC_URL=https://formease-storage.s3.amazonaws.com

# 3. Gnani Speech API (TTS & STT - 5000 Credits)
GNANI_API_KEY=your_gnani_api_key_here
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_TTS_MODEL=timbre-v3.0
GNANI_STT_MODEL=prisma-v3.0
GNANI_DEFAULT_LANG=en-IN
GNANI_INITIAL_CREDITS=5000

# 4. OpenAI NLP (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# 5. Frontend & Firebase
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_OBJECT_STORAGE_BUCKET=formease-storage
VITE_USE_GNANI_VOICE=true
VITE_GNANI_DEFAULT_LANG=en-IN
